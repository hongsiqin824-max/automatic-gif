ARTICLE_PUBLISH_ENABLED=true
GIF_PUBLIC_ORIGIN=https://matchgif.aisportsapp.com
GIF_UPLOAD_ENDPOINT=https://matchgif.aisportsapp.com/api/article-publish/upload
GIF_UPLOAD_TOKEN=
GIF_UPLOAD_TIMEOUT_SECONDS=120

OPEN_PLATFORM_TOKEN_PATH=./data/open-platform-token.json

# 比赛详情和赛事事件接口
GIF_MATCH_USER=your-match-user@example.com
TOKEN_SERVICE_URL=https://matchgif.aisportsapp.com/token-service

# 直播源查询接口。secret 仅供后端读取，不会发送到浏览器。
GIF_SOURCE_USER=your-source-user@example.com
GIF_SOURCE_SECRET=

# 控制台固定端口
GIF_DASHBOARD_HOST=127.0.0.1
GIF_DASHBOARD_PORT=8899

# OCR/T-DEED 搜索窗口默认向前回看秒数，可按缓存长度和延迟调整。
GIF_VISION_SEARCH_BEFORE_SECONDS=120

# 关闭后仅生成 OCR GIF；视频缓存、时钟 OCR 和 OCR 发布继续运行。
DEFAULT_GIF_ENABLED=true

# 同时保持的活动比赛数量
GIF_MAX_CONCURRENT_MATCHES=20
# 自动扫描进入进行中的比赛，查询到直播源后自动启动 Worker。
GIF_AUTO_ADMISSION_ENABLED=true
GIF_AUTO_ADMISSION_POLL_SECONDS=30
GIF_AUTO_ADMISSION_SOURCE_POLL_SECONDS=10
# 首次查不到直播源时，至少在该窗口内等待并再次确认，避免源稍后配置导致漏赛。
GIF_AUTO_ADMISSION_SOURCE_WAIT_SECONDS=60
GIF_AUTO_ADMISSION_SOURCE_EMPTY_CONFIRMATIONS=3
GIF_AUTO_ADMISSION_MAX_BACKOFF_SECONDS=60
GIF_AUTO_ADMISSION_SOURCE_WORKERS=4
GIF_AUTO_ADMISSION_RECORD_RETENTION_SECONDS=86400
GIF_AUTO_ADMISSION_MISSING_CONFIRMATIONS=2
GIF_MAX_CONCURRENT_HEAVY_TASKS=20
GIF_MAX_CONCURRENT_VISION_TASKS=10
# 每个比赛 Worker 的本地 OCR 队列宽度；全局上限仍由上面的协调器控制。
GIF_VISION_WORKERS=2
# 单个 OCR 识别进程的卡死保护；不是整个事件的累计处理时限。
GIF_OCR_TIMEOUT_SECONDS=300
# 比赛结束后最多等待 OCR 收尾的秒数；超时任务会标记为“未完成”。
GIF_WORKER_FINISH_TIMEOUT_SECONDS=600

# 磁盘生命周期：终态 Session/GIF 默认保留 24 小时；孤儿目录需超过 15 分钟无心跳才清理。
GIF_SESSION_RETENTION_SECONDS=86400
GIF_FINAL_GIF_RETENTION_SECONDS=86400
# Daily 19:00 OCR GIF publication report. Keep the webhook secret only in the
# server's private .env; this example intentionally leaves it empty.
GIF_DAILY_REPORT_TIMEZONE=Asia/Shanghai
GIF_DAILY_REPORT_FEISHU_WEBHOOK=
GIF_DISK_CLEANUP_INTERVAL_SECONDS=300
GIF_ORPHAN_CLEANUP_GRACE_SECONDS=900

# 可选：已知转播布局可配置精确 ROI；留空时自动搜索画面左上区域的比赛时钟。
GIF_SCOREBOARD_PROFILE=

# OCR 守护进程默认跨比赛复用同一个识别模型。
GIF_OCR_PERSISTENT_WORKER=1

# 可选：仅对精确定位的 60 秒 OCR GIF 使用 gifsicle -O3 --colors 128。
# 默认关闭；压缩失败、超时或压缩后变大时自动保留原 GIF。
OCR_GIF_GIFSICLE_ENABLED=false
# 留空时从 PATH 查找 gifsicle；也可填写 gifsicle 的绝对路径。
OCR_GIF_GIFSICLE_PATH=
OCR_GIF_GIFSICLE_TIMEOUT_SECONDS=60

ARTICLE_PUBLISH_GIF_DIR=./data/published_gifs
ARTICLE_PUBLISH_DB_PATH=./data/article_publish.sqlite3
ARTICLE_PUBLISH_ACCOUNTS_PATH=./data/publish_accounts.json
ARTICLE_PUBLISH_GIF_MAX_BYTES=52428800
ARTICLE_PUBLISH_VERIFY_PUBLIC_URL=true

# ── 创建文章时的固定字段（8899 自动发文 与 8901 手动截取发文 共用，改完需重启对应服务）──
# 是否把文章放到「新闻列表」（对应懂球帝后台“上新闻列表”开关）：
#   1 = 上列表，文章会出现在 App 新闻流里
#   0 = 不上列表，文章只挂在比赛页 / 通过链接可见
ARTICLE_ADD_TO_TAB=0
# 副标签 id（对应后台“副标签”，接口字段 channelsnew）。
# 多个用英文逗号分隔，如 12039035,12078558；留空则不传该字段。
# 标签 id 在后台「关联标签搜索」里查，填错 id 会被平台拒绝、文章创建失败。
ARTICLE_CHANNELSNEW=12039035
# 栏目 id（对应后台“栏目”，接口字段 tabs[]，数组格式）。
# 多个用英文逗号分隔，如 1,284；留空则不传该字段（文章不进任何栏目）。
# 栏目 id 在后台「文章创建选项」的 allTabs 里查。
ARTICLE_TABS=
# 主标签（接口字段 channels，对应后台“主要标签”）从哪里来：
#   teams = 发文前用主队名、客队名各调一次「关联标签搜索」（admin-archive-channelsearch），
#           优先按球队 id 匹配（比赛接口的 team_A_id/team_B_id 减 50000000 = 标签行的 id），
#           没有 id 或 id 没命中时，才退回“名字完全相同且只有一条”的球队标签；
#           同名有多条就放弃该队（标签库里同名重复很常见，选错会让文章出现两个同名标签）。
#           把两支球队的标签 id 一起传给平台（默认）
#   off   = 不传 channels，完全交给平台按 match_id 自动带标签（旧行为）
# 实测结论：平台会把我们传的 channels 与它按 match_id 自动带出的标签「叠加并按 id 去重」，
# 所以本来就有两队标签的文章不受影响，只带出 0/1 个的会被补齐。
# 搜不到 / 接口报错只写日志、不影响发文；同一支队在进程内缓存 6 小时，重启后重新搜；
# 搜不到或报错也会记 120 秒“负缓存”，期间该队不再调接口（平台故障时不会每篇都等超时）。
# 日志事件：team_channel_resolved（matched_by=id|name）/ team_channel_not_found / team_channel_search_failed
#          / team_channel_skipped_cached_miss（命中负缓存）/ team_channel_config_invalid（本值填错：照常发文但不带标签，状态接口会报错）
ARTICLE_CHANNELS_SOURCE=teams
# 按球队自动补栏目（在 ARTICLE_TABS 的固定栏目之外追加，接口字段同为 tabs[]）：
#   teams = 对 ARTICLE_CHANNELS_SOURCE 解析出的每个球队标签 id 调一次
#           「选球员/球队自动带出球队及栏目」（admin-archive-playerteam），
#           取返回的 new_table_id（平台推荐栏目列表，如 [57, 253]）追加进 tabs[]，
#           等价于后台页面加球队标签时自动勾上的赛事/足球栏目（默认）
#   off   = 只传 ARTICLE_TABS
# 球队标签解析复用上面的 channelsearch 结果与缓存；playerteam 结果同样缓存 6 小时、失败负缓存 120 秒，
# 报错只写日志不影响发文。日志事件：team_tabs_resolved / team_tabs_not_found / team_tabs_lookup_failed
ARTICLE_TABS_SOURCE=teams
# 按赛事在正文 GIF 下面追加一段文字（独立 <p>，即 GIF 后换行）。
# 格式：赛事名=文字;赛事名=文字，赛事名取赛事目录的 competition_name（即列表卡片右上角显示的名字，需完全一致）。
# 留空 = 任何赛事都不加；不在表里的赛事正文仍只有 GIF。
ARTICLE_BODY_FOOTERS=英超=上咪咕独家看英超;西甲=上咪咕独家看西甲;中超=独家看中超就在咪咕
# 【仅 8901 监控台】按赛事固定发布账号（作者），命中的赛事不再从账号池轮换。
# 格式：赛事名=user_id:user_name;…，赛事名同上取 competition_name。留空 = 全部走账号池。
# 只对该场比赛第一次发文时生效；已绑定过作者的比赛沿用旧作者。8899 Dashboard 不读此项。
ARTICLE_COMPETITION_PUBLISH_ACCOUNTS=英超=12061720:咪咕体育;中超=12061720:咪咕体育
# 文章封面（接口字段 litpic）用哪个文件：
#   gif   = 用上传后的 GIF 本身（默认），平台会像官方 gif 合集一样从 GIF 裁缩略图
#   cover = 用 GIF 首帧生成的 960×540 JPG（旧行为）
# 只对官方图片接口上传路径生效；首帧 JPG 两种取值下都会照常生成并上传。
ARTICLE_LITPIC_SOURCE=gif

OPEN_PLATFORM_APPID=your-app-id
OPEN_PLATFORM_APP_SECRET=
OPEN_PLATFORM_API_NAME=admin-archive-createarticle
OPEN_PLATFORM_REDIRECT_URI=https://matchgif.aisportsapp.com/api/open-platform/oauth/callback
OPEN_PLATFORM_TOKEN_PATH=./data/open-platform-token.json

# OCR 第二条链路默认由事件行的“发布”按钮直接正式发布；旧草稿队列仅用于兼容历史任务。
OCR_DRAFT_AUTO_CREATE=true
OCR_DRAFT_POLL_SECONDS=2
OCR_DRAFT_LEASE_SECONDS=180
OCR_DRAFT_PERSON_WAIT_SECONDS=60
# 仅补登记最近生成但首次登记失败的 OCR，避免首次部署批量创建历史草稿。
OCR_DRAFT_RECONCILE_LOOKBACK_SECONDS=900

OPEN_PLATFORM_IMAGE_UPLOAD_TOKEN=
# 官方图片上传单独超时，允许 60～120 秒；默认 120 秒。
OPEN_PLATFORM_IMAGE_UPLOAD_TIMEOUT_SECONDS=120

OCR_IMAGE_UPLOAD_BACKEND=official
# Local development keeps oneDNN enabled. Production starts Dashboard with
# FLAGS_use_mkldnn=0 because the server Paddle environment does not support it.
FLAGS_use_mkldnn=1

GIF_OCR_REPLICAS=1
GIF_SHOTMAP_ENABLED=false

# 8901 监控台实时提醒（进球/红牌）。由独立的懂球帝推送监测服务 match_timeline.mjs
# 经 /api/monitor/events/ingest 投递，8901 汇聚后推飞书 + 页内 toast/列表。
GIF_MONITOR_ALERT_ENABLED=true
# 事件类型过滤（逗号分隔），默认只提醒进球与红牌。
GIF_MONITOR_ALERT_EVENTS=goal,red_card
# 8901 发布表单里哪些事件类型带比分(match_score)，逗号分隔的编号：
# 0 无/1 进球/2 点球/3 点球不进/4 红牌/5 乌龙球/6 进球无效。其余类型页面上比分框置灰、后端也不发。改完需重启 8901。
GIF_MONITOR_SCORE_EVENT_TYPES=1,2
# 8901 监控台发文总闸：false=只在本机存 GIF，完全不碰发文系统（默认 true）。
GIF_MONITOR_PUBLISH_ENABLED=true
# 8901 人工截取的投递方式：draft=仅建草稿(测试期，后台人工再发布)；publish=直接发布上线。改完需重启 8901。
GIF_MONITOR_DELIVERY_MODE=draft
# 飞书自定义机器人 webhook；留空则只在页内提醒、不推飞书。
GIF_MONITOR_FEISHU_WEBHOOK=
# 推送飞书的超时秒数；必须 < monitor 侧 POST 超时(3s)，避免慢但成功被误报为失败。
GIF_MONITOR_FEISHU_TIMEOUT_SECONDS=2.5
# 8901 人工发布成功（懂球帝返回文章 ID）后，把「文章链接 + 比赛/事件/标题 + 操作人 + 时间 + GIF 链接」
# 推到这个飞书群机器人。独立于上面的进球提醒群，避免混群。留空 = 不推发布通知。改完需重启 8901。
GIF_MONITOR_FEISHU_PUBLISH_WEBHOOK=
# 可选：monitor→8901 回环调用的共享密钥，两边须一致；留空则不校验。
GIF_MONITOR_INGEST_TOKEN=

# ---- 8901 飞书登录墙（企业自建应用 网页 OAuth）----
# 两项都配置后整个监控台才要求飞书登录；留空则 8901 保持无鉴权（本地开发、测试）。
# 应用后台：「添加应用能力」勾选网页应用；「安全设置→重定向 URL」登记回调地址；「版本管理与发布」
# 里设置可用范围并发布一个版本（未发布的应用只有协作者能登录）。基础登录（name/open_id）无需申请 API 权限。
GIF_MONITOR_FEISHU_APP_ID=
GIF_MONITOR_FEISHU_APP_SECRET=
# 回调地址必须与飞书后台登记的完全一致。生产走 /gif-monitor/ 子路径时要带前缀：
# https://matchgif.aisportsapp.com/gif-monitor/api/auth/feishu/callback
# 留空时按请求的 X-Forwarded-Proto/Host + GIF_MONITOR_PUBLIC_PREFIX 推导；建议显式写死，
# 写死 https 地址后 Cookie 自动带 Secure 标记。
GIF_MONITOR_FEISHU_REDIRECT_URI=
# 反代子路径前缀，例如通过 nginx location /gif-monitor/ 部署时设为 /gif-monitor。
# 所有浏览器端 URL（登录跳转、回调、login_url）都会自动拼上这个前缀；
# 本地直连 8901 部署时留空即可。
GIF_MONITOR_PUBLIC_PREFIX=
# 可选白名单：逗号分隔，匹配 open_id / union_id / user_id / 邮箱（不区分大小写）。
# 推荐用 open_id（ou_ 开头，登录日志 feishu_login_ok 里会打印，不需要任何额外权限）。
# 用邮箱 / user_id 需要在应用后台「权限管理」额外开通「获取用户邮箱信息」/「获取用户 user ID」
# 字段权限，否则 user_info 不返回这些字段，白名单会静默匹配失败（全部 403）。
# 留空 = 企业内对该应用可见的任何成员都可登录（可用范围在飞书后台配）。
# 开了审批模式（下面 ADMIN_USERS 非空）之后这里的人仍然免审直接进，可以留空不用。
GIF_MONITOR_FEISHU_ALLOWED_USERS=
# 审批模式开关：填管理员 open_id（逗号分隔）即开启。开启后：
#   管理员 / 上面白名单里的人 → 直接进；
#   其他人 → 停在等待页（/auth/pending），页面上有「申请访问」按钮；他点了才会记一条
#     "待审批"申请并通知管理员，不点什么都不发生；
#   管理员在 /admin/access 页点"批准"立即生效（不用重启），等待页自动跳进监控台；
#   被拒绝的人再登录仍停在等待页，可随时改为批准；已批准的也可"撤销"，撤销后下一次请求即被踢出。
#   外部人员（非本企业飞书账号）走不了飞书登录：管理员在 /admin/access 生成「访客链接」发给他们，
#   点开填姓名+备注提交申请，进同一个审批队列；链接可转发（谁点都要审批），可随时重置作废。
# 申请记录存 data/monitor_access.sqlite3，重启不丢。留空 = 关闭审批模式，只按上面白名单。
GIF_MONITOR_FEISHU_ADMIN_USERS=
# 新申请通知走哪个飞书群机器人 webhook。留空 = 复用上面 GIF_MONITOR_FEISHU_WEBHOOK（进球提醒群）；
# 想分开发到管理员小群就单独填一个。两者都空 = 不通知，管理员自己打开 /admin/access 看。
GIF_MONITOR_FEISHU_ACCESS_WEBHOOK=
# 登录会话有效期（小时）。到期后下次操作自动跳回飞书重新授权（已批准的人不用再审批）。
# 720 = 30 天。设长没有安全代价：每个请求都会回查审批表，管理员点「撤销」立即生效。
GIF_MONITOR_AUTH_SESSION_HOURS=720
# Cookie/state 签名密钥。留空则首次启动自动生成并持久化到 data/monitor_auth_secret，
# 重启不掉线；多实例部署时请显式配置同一个值。
GIF_MONITOR_AUTH_SECRET=
# Cookie Secure 标记。留空 = 自动（回调地址是 https 才启用）；纯 http 内网部署保持留空即可。
GIF_MONITOR_AUTH_COOKIE_SECURE=

# 提醒缓冲保留条数。两个用途：① 页面「最近事件」列表能回看多少条；
# ② 截取 GIF 时在这些提醒里找“这一刀对应哪个进球”，自动填 match_time/match_score。
# 太小（如 50）周末十几场并发时一个多小时就滚掉了，截取会匹配不到提醒；500 够一整晚。
GIF_MONITOR_ALERT_BUFFER=500
# 提醒持久化到 SQLite 的路径（相对仓库根目录）。8901 重启（如 deploy-gif）后从这里恢复
# 缓冲和序号，重启前的进球不会丢。留空 = 只放内存、重启即清空。
GIF_MONITOR_ALERT_DB_PATH=data/monitor_alerts.sqlite3
# 截取→提醒 匹配规则。截取锚点 = 那一帧切片时的服务器时间（已含画面落后直播的延迟）；
# 推送到达时间 − 锚点 = 推送延迟 − 画面延迟，可正可负、事先不知道，所以前后两边都要留窗口：
# 往前回看 600 秒（10 分钟），往后超前 180 秒（推送比画面慢时也能等到）。
# 窗口内若有多条提醒，取「到达时间 − 锚点」最接近 EXPECTED_OFFSET 的那条（不是最新的那条，
# 否则推送还没到时会悄悄选中上一个球）。EXPECTED_OFFSET 先填 0，跑几场后看
# monitor_clip 日志里 alert_match.delta_seconds 的分布再定（可为负数）。
# 次优候选与选中项相差小于 AMBIGUOUS 秒 → 标“候选多条，请核对”；
# 选中项离预期偏差超过 WEAK 秒 → 标“可信度低，请核对”（多半是这个球的推送还没到）。
GIF_MONITOR_ALERT_MATCH_LOOKBACK_SECONDS=600
GIF_MONITOR_ALERT_MATCH_LOOKAHEAD_SECONDS=180
GIF_MONITOR_ALERT_MATCH_EXPECTED_OFFSET_SECONDS=0
GIF_MONITOR_ALERT_MATCH_AMBIGUOUS_SECONDS=180
GIF_MONITOR_ALERT_MATCH_WEAK_SECONDS=240

# ══════════════════════════════════════════════════════════════════════════════
# 8901 监控台 · 预览延迟相关的全部开关与可调参数
# ══════════════════════════════════════════════════════════════════════════════
# 【改了之后怎么生效】重启 8901（服务器 systemctl restart gif-monitor），浏览器 Cmd+Shift+R。
# 【怎么确认生效】8901 启动日志里有一行 {"event":"monitor_latency_config", …} 列出当前所有生效值；
#   浏览器 Console 也有一行 [LATENCY-CONFIG]。填了越界的值不会报错，服务器会自动修正并在
#   "adjusted" 里写明"谁=原值->修正值"，看到非空就知道有参数没按你填的跑。
# 【延迟是怎么叠出来的】HLS 路径（大窗、以及 WebRTC 关闭时的小窗）：
#   懂球帝源 → ffmpeg 转码 → 写满一个片 → 浏览器拉到 → hls.js 停在边缘后 N 片 → 画面
#   稳态延迟 ≈ 片长 × N + 约 0.5s。片长和 N 是两个真正的杠杆，其余参数只影响"掉队后怎么追回"。
# 【调参原则】一次只动一个，看一场再动下一个。顺序建议：先 C5/C6 跳回阈值，再 B1（3→2），再片长。
# 【独立开关】WebRTC（D1，默认关）、追帧总开关（C1，默认开）、倍速层（C2）、小窗跳回（C5，0=关）、
#   大窗跳回（C6，0=关）、片长（A1，数值，永远生效）。任一项效果不好，单独改回去即可恢复，互不影响。
# ──────────────────────────────────────────────────────────────────────────────

# ── A. HLS 分片（服务器 ffmpeg 侧，影响大窗 + 截取 + 关闭 WebRTC 时的小窗）──

# A1. 每个 HLS 分片的时长（秒，整数 ≥1）。
#     1 = 现在（目标延迟 3s）；2 = 改之前（目标 6s，对网络抖动更宽容，卡顿更少）。
#     片越短延迟越低，但关键帧更密（码率 +15~30%）、浏览器请求数翻倍。
#     ⚠ 改片长要同步改 A2，保持回看总秒数不变：1s→180、2s→90、3s→60。
GIF_PREVIEW_SEGMENT_SECONDS=1

# A2. 服务器保留多少个分片做回看缓冲（环形，老的自动删）。回看总秒数 = A1 × A2。
#     大窗拖回看、截 GIF 都只能在这段时间内；C9 兜底阈值也受它限制。
GIF_MONITOR_PREVIEW_SEGMENTS=180

# A3. x264 编码预设：ultrafast / superfast / veryfast / faster / fast / medium。
#     越靠左越省 CPU、画质略差。只有服务器 CPU 吃紧、转码跟不上实时（日志里 ffmpeg 频繁重启、
#     画面一卡一卡）时才往左调；平时别动。填错值自动回退 veryfast。
GIF_PREVIEW_X264_PRESET=veryfast

# ── B. 播放器（浏览器 hls.js 侧）──

# B1. hls.js 把播放头停在直播边缘后面几个分片（N）。目标延迟 = A1 × B1。
#     3 = 现在。2 = 延迟再减一个片长，但缓冲只剩 1 片，网络稍抖就 BUFFERING。
#     下限 2（填 1 会被修正成 2：那样永远在等 ffmpeg 正在写的那个片）；上限 6。
GIF_MONITOR_HLS_LIVE_SYNC_COUNT=3

# ── C. 落后了怎么追回来（浏览器侧）──
#     背景：每次卡顿都会让播放头永久落后一点，攒几分钟就落后几十秒，没人拉它就一直落后。
#     机制按"温和 → 激进"排：倍速悄悄追（C2~C4）、小窗直接跳回（C5）、大窗直接跳回（C6~C7）、兜底（C8~C9）。
#     "落后"= 徽标上的秒数，稳态在目标延迟（A1×B1=3s）附近晃，3~4.5s 都算正常。
#
#     现在的组合 = 「小窗、大窗落后 ≥8s 都立即跳回直播；大窗有人在操作时不干涉；倍速关」。

# C1. 总开关。false = 下面 C2~C9 全部失效，永不加速、永不自动跳回直播（= 没加这个功能之前的行为）。
#     怀疑是追帧导致画面异常时先关这个，一键回到旧行为。
GIF_MONITOR_CATCHUP_ENABLED=true

# C2. 【倍速层开关】true = 小窗落后超过 C4 时按 C3 倍速悄悄追，追到目标附近恢复 1x，画面连贯不闪。
#     false = 不加速。现在关着：有 C5 直接跳，倍速层多余；想要"不闪但追得慢"的效果再打开。
GIF_MONITOR_CATCHUP_RATE_ENABLED=false

# C3. 倍速（1.0 ~ 2.0）。1.5 肉眼基本察觉不到；超过 2.0 浏览器会静音/丢帧，填了会被修正成 2.0。
GIF_MONITOR_CATCHUP_RATE=1.5

# C4. 【倍速层时间】小窗落后多少秒开始倍速（秒）。下限 = 目标延迟+2 = 5（填更小会被修正，否则在 1x 和倍速之间来回抖）。
#     注意：倍速只在"落后 ≥C4 且 <C5"这段区间起作用；C5 比 C4 小时倍速层永远轮不到（现在 8 < 12 就是这样）。
GIF_MONITOR_CATCHUP_MIN_LAG=12

# C5. 【小窗直接跳回直播】小窗落后多少秒就立即跳回直播（秒）。0 = 关。只管小窗。
#     8 = 现在。目标 3s，稳态读数在 3~4.5 晃，8 留了约 4s 余量，大约连续卡两次才会跳。
#     跳的瞬间画面"闪一下"、跳过中间那几秒内容，换来时效。
#     调参指引：Console 里 [AUTO-SEEK] … tile-limit 刷屏、画面老闪 → 调大到 10；
#               想更激进 → 6（公网一次普通抖动就可能误跳）；下限 5（目标+2），再小会被修正。
#     上限 = C9（超过会被修正成 C9）。
GIF_MONITOR_TILE_SEEK_LAG=8

# C6. 【大窗直接跳回直播】放大后的大窗落后多少秒就立即跳回直播（秒）。0 = 关。
#     0 = 推荐：大窗在回看范围内随意拖动、停多久都不会被拉回直播；C7/C8/C9 对大窗一并失效，
#     只剩「回看余量 ≤10s」（快被服务器删掉）时才强制跳回，≤30s 时先红字提示。小窗不受影响。
#     若改成 >0（如 8）：大窗落后超过该值就跳，但以下任一情况成立时【不跳】：
#       a) 点过「开始」设了区间起点、还没截完或没超时（180s）；
#       b) 画面是暂停的（在挑帧）；
#       c) 最近 C7 秒内在大窗手动拖过进度条（往回 ≥1s 或往前 ≥5s，任一方向都算）或点过暂停。
#     被挡住时 Console 打一行 [AUTO-SEEK] … stage-hold (range/paused/grace)，不会刷屏。
#     大窗误跳的代价比小窗高（可能跳过正要截的画面），所以不建议比 C5 更小。
#     下限 5，上限 = C9。
GIF_MONITOR_STAGE_AUTO_SEEK_LAG=0

# C7. 【大窗操作后豁免多久】在大窗手动拖动/暂停之后，多少秒内 C6 不生效（秒）。0 = 不豁免（只看 a、b 两条）。
#     C6=0 时此项无意义。60：拖回去找进球 + 点截取一般一分钟内完成；之后没再动，60s 后自动回到直播。
#     连截多段觉得老被拽走 → 调大到 120；觉得拖完很久还不回 → 调小到 30。上限 600。
#     注意：点「截取 10 秒」按钮本身不算操作，不会刷新这个计时。
GIF_MONITOR_STAGE_USER_GRACE_SECONDS=60

# C8. 【大窗·切回前台】把页面切回前台时，大窗落后超过多少秒才自动跳回直播（秒）。
#     C6=0 时大窗切回前台一律不跳。否则小于这个值保留你拖回去看的位置；有人在操作（C6 的 a/b/c）时也不跳。
#     小窗切回前台一律跳回直播。
GIF_MONITOR_STAGE_SEEK_LAG=30

# C9. 【兜底】落后超过多少秒就跳回直播（秒）。小窗无条件跳；大窗 C6=0 时不跳，C6>0 时有人在操作（a/b/c）也不跳。
#     大窗真正的兜底是「回看余量」：播放位置离缓冲尽头 ≤30s 时提示、≤10s 时无条件跳回（写死在 app.js）。
#     上限 = 回看总秒数(A1×A2) − 10，再大会被修正。
GIF_MONITOR_HARD_SEEK_LAG=150

# ── D. 小窗 WebRTC（方案 H，BACKLOG 11.13；需要服务器装 mediamtx，见 DEPLOY_8901.md 阶段 7）──
#     小窗画面改走 WebRTC（延迟 ≈0.5s，接近 VLC）；大窗与截 GIF 仍走上面的 HLS 环形缓冲，不受影响。
#     任何环节失败（mediamtx 没起/挂了、源没就绪、浏览器连不上 8189）都自动回退到 HLS 小窗，
#     页面不黑屏、只是回到现在的延迟。mediamtx 重启后 8901 会自动重新注册，不用管。

# D1. 总开关。false = 现状，WebRTC 相关代码一行都不执行，也不碰 mediamtx；true = 小窗尝试 WebRTC。
#     ⚠ 开之前必须先把 mediamtx 装好并跑起来（阶段 7.1~7.3），否则开了也只是每场多等 2 秒再回退。
GIF_MONITOR_WEBRTC_ENABLED=false

# D2. mediamtx 控制 API 地址（只监听本机）。8901 开一场就在这里注册一个 path（名字 = match_id，
#     源 = 懂球帝 RTMP），关一场就删掉。
GIF_MONITOR_MEDIAMTX_API=http://127.0.0.1:9997

# D3. 预览 ffmpeg 从 mediamtx 回读的 RTSP 前缀（本机回环）。开 WebRTC 后源只从懂球帝拉一次，
#     mediamtx 分给浏览器（WebRTC）和 ffmpeg（HLS）两路，画面一致、省一半上游带宽。
GIF_MONITOR_MEDIAMTX_RTSP=rtsp://127.0.0.1:8554

# D4. 浏览器拉 WebRTC 的 WHEP 地址前缀。相对路径，相对于页面所在的 /gif-monitor/，
#     由 nginx 把 /gif-monitor/whep/ 反代到 mediamtx 的 :8889。本地调试没有 nginx 时
#     可以填 http://127.0.0.1:8889/ 直连。
GIF_MONITOR_WHEP_BASE=whep/

# D5. 调 mediamtx API 的单次超时（秒）。mediamtx 没起时，开一场最多多等这么久就回退 HLS。
GIF_MONITOR_MEDIAMTX_TIMEOUT_SECONDS=2

# D6. 注册 path 后等懂球帝源连上、拿到画面的总超时（秒）。超时就回退 HLS 直拉。
#     源本来就慢的比赛可以适当调大（例如 10），代价是开一场时等得更久。
GIF_MONITOR_MEDIAMTX_READY_SECONDS=6
