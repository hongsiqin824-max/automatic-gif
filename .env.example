# 比赛详情和赛事事件接口
GIF_MATCH_USER=hongsiqin@dongqiudi.com

# 直播源查询接口。secret 只放在本机环境变量，不写入前端。
GIF_SOURCE_USER=xuxinan@dongqiudi.com
GIF_SOURCE_SECRET=

# 控制台固定端口
GIF_DASHBOARD_HOST=127.0.0.1
GIF_DASHBOARD_PORT=8899

# OCR/T-DEED 搜索窗口默认向前回看秒数，可按缓存长度和延迟调整。
GIF_VISION_SEARCH_BEFORE_SECONDS=120

# 多比赛与跨 Worker 的全局重任务上限
GIF_MAX_CONCURRENT_MATCHES=8
GIF_MAX_CONCURRENT_HEAVY_TASKS=5
GIF_MAX_CONCURRENT_VISION_TASKS=2
# 每个比赛 Worker 的本地 OCR 队列宽度；全局上限仍由上面的协调器控制。
GIF_VISION_WORKERS=2
# 单个 OCR 识别进程的卡死保护；不是整个事件的累计处理时限。
GIF_OCR_TIMEOUT_SECONDS=300
# 比赛结束后最多等待 OCR 收尾的秒数；超时任务会标记为“未完成”。
GIF_WORKER_FINISH_TIMEOUT_SECONDS=600

# 磁盘生命周期：终态 Session/GIF 默认保留 24 小时；孤儿目录需超过 15 分钟无心跳才清理。
GIF_SESSION_RETENTION_SECONDS=86400
GIF_FINAL_GIF_RETENTION_SECONDS=86400
GIF_DISK_CLEANUP_INTERVAL_SECONDS=300
GIF_ORPHAN_CLEANUP_GRACE_SECONDS=900

# 可选：已知转播布局可配置精确 ROI；留空时自动搜索画面左上区域的比赛时钟。
GIF_SCOREBOARD_PROFILE=

# OCR 守护进程默认跨比赛复用同一个识别模型。
GIF_OCR_PERSISTENT_WORKER=1
# 可选：独立 OCR 虚拟环境的 Python；服务器发布目录切换时建议使用稳定绝对路径。
GIF_OCR_PYTHON=
# Linux CPU 上关闭 Paddle oneDNN，避免部分 Paddle/PIR 版本推理崩溃。
FLAGS_use_mkldnn=0
