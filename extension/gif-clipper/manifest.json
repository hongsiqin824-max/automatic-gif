{
  "manifest_version": 3,
  "name": "GIF 工作台 · 直播页截取",
  "version": "0.1.5",
  "description": "在任意直播页面录最近几分钟画面，Alt+1 设起点、Alt+2 结束生成 GIF，发到 8901 工作台的侧边栏里填表发布。",
  "permissions": ["storage", "sidePanel", "tabs", "commands", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["content/toast.js", "content/recorder.js", "content/review.js", "content/finder.js", "content/bar.js"]
    }
  ],
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "GIF 工作台（点击打开侧栏和小条）" },
  "options_page": "options.html",
  "commands": {
    "set-start": {
      "suggested_key": { "default": "Alt+1" },
      "description": "设起点（当前画面）"
    },
    "finish": {
      "suggested_key": { "default": "Alt+2" },
      "description": "结束并生成 GIF"
    },
    "review": {
      "suggested_key": { "default": "Alt+3" },
      "description": "回看缓冲，拖动选起止点"
    },
    "toggle-bar": {
      "suggested_key": { "default": "Alt+0" },
      "description": "显示 / 隐藏页面小条"
    }
  }
}
